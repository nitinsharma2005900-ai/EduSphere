# ==============================================================================
# EduSphere Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services:
# cp .env.example .env

# NODE & SYSTEM
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
ANALYTICS_PORT=8000
MAILPIT_PORT=8025

# FRONTEND URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000

# DATABASE (PostgreSQL)
# For Docker Compose: postgresql://edusphere:edusphere_secure_pass@postgres:5432/edusphere_db?schema=public
# For Localhost standalone: postgresql://edusphere:edusphere_secure_pass@localhost:5432/edusphere_db?schema=public
DATABASE_URL=postgresql://edusphere:edusphere_secure_pass@localhost:5432/edusphere_db?schema=public
POSTGRES_USER=edusphere
POSTGRES_PASSWORD=edusphere_secure_pass
POSTGRES_DB=edusphere_db
POSTGRES_PORT=5432

# REDIS (Caching, BullMQ Queue, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AUTHENTICATION & SECURITY
JWT_ACCESS_SECRET=edusphere_jwt_super_secure_access_secret_key_2026_x9281!
JWT_REFRESH_SECRET=edusphere_jwt_super_secure_refresh_secret_key_2026_r4719@
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# PYTHON FASTAPI ANALYTICS MICROSERVICE
ANALYTICS_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=edusphere_internal_microservice_secret_key_2026_secure!
SERVICE_TIMEOUT_SECONDS=10

# EDTECH INTEGRATIONS
# 1. Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=edusphere_minio_admin
S3_SECRET_KEY=edusphere_minio_super_secret_pass_2026
S3_BUCKET_NAME=edusphere-media
LOCAL_UPLOAD_DIR=./storage/uploads

# 2. Email (Mailpit / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EduSphere Platform <notifications@edusphere.demo>"

# 3. Sandbox Payments (Stripe / Razorpay sandbox)
PAYMENT_PROVIDER=STRIPE_SANDBOX
STRIPE_PUBLISHABLE_KEY=pk_test_edusphere_mock_key_51NxYz
STRIPE_SECRET_KEY=sk_test_edusphere_mock_secret_key_98AbCd
STRIPE_WEBHOOK_SECRET=whsec_edusphere_mock_webhook_secret_12345
PAYMENT_SANDBOX_MODE=true

# 4. Video Streaming Provider
VIDEO_PROVIDER=ADAPTIVE_MOCK_STREAMING
VIDEO_CDN_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample
