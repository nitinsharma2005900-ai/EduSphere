FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package*.json ./
COPY services/api/package*.json ./services/api/
COPY packages/shared/package*.json ./packages/shared/
COPY database/prisma ./database/prisma/
RUN npm ci

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build --workspace=packages/shared
RUN cd services/api && npx prisma generate --schema=../../database/prisma/schema.prisma
RUN npm run build --workspace=services/api

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/services/api/dist ./dist
COPY --from=builder /app/packages/shared/dist ./node_modules/@edusphere/shared/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/services/api/package.json ./package.json

EXPOSE 4000
CMD ["node", "dist/index.js"]
